 RULES_GO = "rules_go" if _is_bzlmod_enabled() else "io_bazel_rules_go"
 
+def _rules_go_has_pack(repository_ctx):
+    """Whether `go_toolchain` requires a `pack` tool, as in `rules_go` >= 0.57.
+
+    `go_tool_binary` then builds it, as its `out_pack` output.
+    `RULES_GO_VERSION` is not reliable, so check for the attribute itself.
+    """
+    go_toolchain_bzl = repository_ctx.read(Label("@io_bazel_rules_go//go/private:go_toolchain.bzl"))
+    return '"pack": attr.label(' in go_toolchain_bzl
+
